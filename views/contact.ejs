<!DOCTYPE html>
<html lang="ja">
  <%- include("./partials/head.ejs") %>
  <link rel="stylesheet" href="/css/button.css" />

  <body>
    <main>
      <section>
        <div id="container">
        <%- include("./partials/header.ejs") %>
          <div id="contents">
            <h2><%= contact.contacthead() %></h2>
            <form id="registForm" name="form1" method="post" action="/form">
              <table class="ta1">
                <tr>
                  <th width="150"><%= contact.namehead() %><span style="color: red">※</span></th>
                  <td>
                    <input
                      id="customername"
                      name="customername"
                      value=""
                      type="text"
                      size="40"
                      maxlength="500"
                      class="ws"
                    />
                  </td>
                </tr>
                <tr>
                  <th width="150">
                    <%= contact.mailhead() %><span style="color: red">※</span>
                  </th>
                  <td>
                    <input
                      id="customermail"
                      name="customermail"
                      value=""
                      type="text"
                      size="40"
                      maxlength="500"
                      class="ws"
                    />
                  </td>
                </tr>
                <tr>
                  <th><%= contact.contenthead() %><span style="color: red">※</span></th>
                  <td>
                    <textarea
                      id="content"
                      name="content"
                      cols="40"
                      rows="10"
                      class="wl"
                    ></textarea>
                  </td>
                </tr>
              </table>
              <p class="c">
                <button type="submit" class="button-g button-6 button-standard">
                  <%= contact.sendbutton() %>
                </button>
                <button type="reset" class="button-g button-standard">
                  <%= contact.resetbutton() %>
                </button>
              </p>
            </form>
          </div>
        </section>
      </main>
      <%- include("./partials/footer.ejs") %>
      <script>
        $(function () {
          getGlobalLang("<%= language %>");
        });
      </script>
      <script src="/js/validation.js"></script>
  </body>
</html>
