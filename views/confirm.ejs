<!DOCTYPE html>
<html lang="ja">
  <%- include("./partials/head.ejs") %>
  <link rel="stylesheet" href="/css/button.css" />

  <body>
    <div id="container">
      <main>
        <section>
          <%- include("./partials/header.ejs") %>
          <div id="contents">
            <h2>
              <span class="hosoku"><%= common.confirmhead() %></span>
            </h2>
            <form name="form1" method="post" action="/confirmed">
              <table class="ta1">
                <tr>
                  <th width="150">
                    <%= contact.namehead() %>
                  </th>
                  <td>
                    <%= customername %>
                  </td>
                </tr>
                <tr>
                  <th width="150">
                    <%= contact.mailhead() %>
                  </th>
                  <td>
                    <%= customermail %>
                  </td>
                </tr>
                <tr>
                  <th>
                    <%= contact.contenthead() %>
                  </th>
                  <td>
                    <%= content %>
                  </td>
                </tr>
              </table>
              <p class="c">
                <button type="submit" class="button-g button-6 button-standard"
                  onClick="document.form1.mode.value='reinput';document.form1.submit()">
                  <%= contact.sendbutton() %>
                </button>
              </p>
              <input type="hidden" name="customerid" value="<%= customerid %>" />
            </form>
          </div>
        </div>
      </section>
    </main>
    <%- include("./partials/footer.ejs") %>
  </body>

</html>